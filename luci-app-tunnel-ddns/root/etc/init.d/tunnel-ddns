#!/bin/sh /etc/rc.common
# Applies /etc/config/tunnel-ddns to the system: firewall rule, uhttpd document
# root/port/certificate, the LuCI login gate of the served site and the cron jobs (address
# updates, certificate renewal, site rebuild).

START=96
USE_PROCD=1

start_service() {
	/usr/libexec/tunnel-ddns/sync
}

reload_service() {
	/usr/libexec/tunnel-ddns/sync
}

service_triggers() {
	procd_add_reload_trigger "tunnel-ddns"
}
