#!/usr/bin/env ucode
// tunnel-ddns sync: make the system match /etc/config/tunnel-ddns.
//   sync          apply the configuration (idempotent, restarts only what changed)
//   sync revert   undo everything the package configured (used when the package is removed)

'use strict';

import { readfile, writefile, mkdir, unlink, rmdir, lsdir, lstat, readlink, symlink, rename, access, popen, glob } from 'fs';
import { cursor } from 'uci';

const CFG        = 'tunnel-ddns';
const SITES      = '/usr/share/www';                // document roots, one directory per site
const BACKENDS   = '/etc/tunnel-ddns/sites';        // the sites' build scripts (the archive's .tunnel-ddns/)
const CERTS      = '/etc/ssl/tunnel-ddns';
const STATE_DIR  = '/etc/tunnel-ddns';
const BACKUP     = `${STATE_DIR}/uhttpd.backup`;
const STATIC     = `${STATE_DIR}/static.name`;     // name of the link to LuCI's static files inside a served site
const LUCI_GATE  = '/usr/libexec/tunnel-ddns/luci-gate';
const NOT_FOUND  = '/usr/libexec/tunnel-ddns/not-found';
const SITEBUILD  = '/usr/libexec/tunnel-ddns/sitebuild';
const UPDATE     = '/usr/libexec/tunnel-ddns/update';
const XRAY_CONF  = '/etc/tunnel-server/config.json';   // the xray server's configuration in effect
const BEHIND_PORT = 4443;                               // where uhttpd serves HTTPS while Xray holds its port
const CRONTAB    = '/etc/crontabs/root';

const mode = ARGV[0] ?? 'apply';
let uci = cursor();
for (let c in [ CFG, 'uhttpd', 'luci', 'firewall', 'ddns', 'tunnel-server' ]) uci.load(c);
let changed = {};

function shq(s) { return "'" + replace(`${s ?? ''}`, "'", "'\\''") + "'"; }
function log(msg) { system(`logger -t tunnel-ddns ${shq(msg)}`); }
function is_file(p) { return lstat(p)?.type == 'file'; }
function is_dir(p) { return lstat(p)?.type == 'directory'; }
function is_link(p) { return lstat(p)?.type == 'link'; }

// set an option only when its value differs (a list as a space-separated string); remember the config
function uset(c, sec, opt, val, as_list) {
	let cur = uci.get(c, sec, opt);
	if (type(cur) == 'array') cur = join(' ', cur);
	if (!length(val)) {
		if (cur != null) { uci.delete(c, sec, opt); changed[c] = true; }
		return;
	}
	if (cur == val) return;
	uci.set(c, sec, opt, as_list ? split(val, ' ') : val);
	changed[c] = true;
}

let main = uci.get_all(CFG, 'main') ?? {};
let site_enabled = (mode == 'apply' && main.site_enabled == '1');
let site = main.site || 'default';
let site_port = match(main.site_port ?? '', /^[0-9]+$/) ? main.site_port : '443';
let schedule = main.site_schedule ?? '';

// the site to serve: the selected one if it has a page, else the built-in default
let serving = false;
if (site_enabled) {
	if (!is_file(`${SITES}/${site}/index.html`)) site = 'default';
	serving = is_file(`${SITES}/${site}/index.html`);
}
// a site with its own login page takes over the LuCI login (see luci-gate)
let login_page = serving && access(`${SITES}/${site}/cgi-bin/login`) == true;

// the stock uhttpd and LuCI values, saved once before anything is changed
function backup() {
	let b = {};
	for (let l in split(readfile(BACKUP) ?? '', '\n')) {
		let m = match(l, /^([a-z]+)=(.*)$/);
		if (m) b[m[1]] = m[2];
	}
	return b;
}
function backup_make() {
	if (access(BACKUP)) return;
	mkdir(STATE_DIR, 0o755);
	let g = (c, o) => { let v = uci.get(c, 'main', o); return (type(v) == 'array') ? join(' ', v) : (v ?? ''); };
	writefile(BACKUP, join('\n', [
		`home=${g('uhttpd', 'home')}`, `cert=${g('uhttpd', 'cert')}`, `key=${g('uhttpd', 'key')}`,
		`https=${g('uhttpd', 'listen_https')}`, `ubus=${g('uhttpd', 'ubus_prefix')}`,
		`dirlists=${g('uhttpd', 'no_dirlists')}`, `errorpage=${g('uhttpd', 'error_page')}`,
		`resourcebase=${g('luci', 'resourcebase')}`, `mediaurlbase=${g('luci', 'mediaurlbase')}`,
		`ubuspath=${g('luci', 'ubuspath')}` ]) + '\n');
}

// The HTTPS port uhttpd would listen on: the site's port, or the stock one when no site is served.
// When the Xray server (its configuration file in effect, so a rejected one does not count)
// listens on that port with a TCP transport (VLESS; Hysteria2 is UDP), it sits in front: uhttpd
// serves HTTPS on 127.0.0.1:BEHIND_PORT only, Xray passes every connection that is not one of its
// clients through to it (the REALITY target), and the port is opened by the server's own rule.
let https_port = site_port;
if (!serving) {
	let h = backup().https;
	if (h == null) { h = uci.get('uhttpd', 'main', 'listen_https'); if (type(h) == 'array') h = join(' ', h); }
	let m = match(split(h ?? '', ' ')[0] ?? '', /:([0-9]+)$/);
	https_port = m ? m[1] : '443';
}
let xray_front = false;
if (uci.get('tunnel-server', 'main', 'enabled') == '1') {
	let x = null;
	try { x = json(readfile(XRAY_CONF) ?? ''); } catch (e) { x = null; }
	for (let ib in x?.inbounds ?? [])
		if (ib?.protocol == 'vless' && `${ib.port}` == https_port) xray_front = true;
}

// ---------- domains: address updates and certificate renewal from cron ----------

let want_update = false, want_renewal = false;
uci.foreach(CFG, 'domain', function(s) {
	let host = lc(s.hostname ?? '');
	if (mode != 'apply' || s.enabled != '1' || !host || !s.provider) return;
	want_update = true;
	let dir = (s.staging == '1') ? `${STATE_DIR}/acme-staging` : `${STATE_DIR}/acme`;
	if (access(`${CERTS}/${host}/fullchain.pem`) || access(`${dir}/${host}/cert.pem`)) want_renewal = true;
});

// sections an earlier version kept in ddns-scripts
let old = [];
uci.foreach('ddns', 'service', function(s) { if (index(s['.name'], 'tunnel_ddns_') == 0) push(old, s['.name']); });
if (length(old)) {
	for (let s in old) uci.delete('ddns', s);
	uci.commit('ddns');
	system('[ -x /etc/init.d/ddns ] && /etc/init.d/ddns restart >/dev/null 2>&1');
	log(`ddns-scripts sections of an earlier version removed: ${join(' ', old)}`);
}
for (let f in [ ...(glob('/var/run/ddns/tunnel_ddns_*') ?? []), ...(glob('/var/log/ddns/tunnel_ddns_*') ?? []) ]) unlink(f);

// ---------- firewall ----------

if (serving && !xray_front) {
	if (uci.get('firewall', 'tunnel_ddns_https') != 'rule') { uci.set('firewall', 'tunnel_ddns_https', 'rule'); changed.firewall = true; }
	uset('firewall', 'tunnel_ddns_https', 'name', 'tunnel-ddns: HTTPS from WAN');
	uset('firewall', 'tunnel_ddns_https', 'src', 'wan');
	uset('firewall', 'tunnel_ddns_https', 'proto', 'tcp');
	uset('firewall', 'tunnel_ddns_https', 'dest_port', site_port);
	uset('firewall', 'tunnel_ddns_https', 'target', 'ACCEPT');
	uset('firewall', 'tunnel_ddns_https', 'enabled', '1');
}
else if (uci.get('firewall', 'tunnel_ddns_https') == 'rule') {
	uci.delete('firewall', 'tunnel_ddns_https');
	changed.firewall = true;
}
if (changed.firewall) {
	uci.commit('firewall');
	system('/etc/init.d/firewall reload >/dev/null 2>&1');
	log(`firewall rule tunnel_ddns_https: ${(serving && !xray_front) ? 'port ' + site_port : 'removed'}`);
}

// ---------- LuCI entry points inside a site's document root ----------
// Every /www/cgi-bin/* entry is linked by name into the served site's root, and LuCI's static
// files (/www/luci-static) under a random name that is made once and kept in STATIC, so that
// nothing in the site's address space names the administration software; LuCI is told the new
// location through its resourcebase/mediaurlbase options. The same link is also placed under
// /www while a site is served, because some LuCI pages (the status overview) look their parts
// up on disk at /www + the resource URL. With a site login page, cgi-bin/luci points at the gate
// instead of the stock dispatcher. A file the site ships under the same name is left alone.

function static_name() {
	let n = trim(readfile(STATIC) ?? '');
	if (!match(n, /^[0-9a-f]{16}$/)) {
		mkdir(STATE_DIR, 0o755);
		n = hexenc(readfile('/dev/urandom', 8));
		writefile(STATIC, n);
	}
	return n;
}

function link_set(path, target) {
	if (is_link(path)) {
		if (readlink(path) == target) return;
		unlink(path);
	}
	else if (lstat(path)) return;
	symlink(target, path);
}

// only a link into /www or to this package's scripts is removed
function link_remove(path) {
	if (!is_link(path)) return;
	let t = readlink(path) ?? '';
	if (index(t, '/www/') == 0 || index(t, '/usr/libexec/tunnel-ddns/') == 0) unlink(path);
}

function site_links(add, dir) {
	if (!is_dir(dir)) return;
	if (is_link(`${dir}/cgi-bin`)) unlink(`${dir}/cgi-bin`);       // one link for the whole directory: package 1.0.0-r1
	let name = add ? static_name() : null;
	if (add) {
		mkdir(`${dir}/cgi-bin`, 0o755);
		for (let e in lsdir('/www/cgi-bin') ?? [])
			link_set(`${dir}/cgi-bin/${e}`, (login_page && e == 'luci') ? LUCI_GATE : `/www/cgi-bin/${e}`);
		link_set(`${dir}/cgi-bin/not-found`, NOT_FOUND);
		link_set(`${dir}/${name}`, '/www/luci-static');
	}
	else {
		for (let e in lsdir(`${dir}/cgi-bin`) ?? []) link_remove(`${dir}/cgi-bin/${e}`);
		rmdir(`${dir}/cgi-bin`);
	}
	// any link to LuCI's static files that is not the current one
	for (let e in lsdir(dir) ?? [])
		if (is_link(`${dir}/${e}`) && readlink(`${dir}/${e}`) == '/www/luci-static' && !(add && e == name))
			unlink(`${dir}/${e}`);
}

// ---------- uhttpd ----------

let w = null;
if (serving) {
	backup_make();
	let b = backup(), name = static_name();
	let host = lc(uci.get(CFG, main.site_domain ?? '', 'hostname') ?? '');
	let own = (host && access(`${CERTS}/${host}/fullchain.pem`) && access(`${CERTS}/${host}/key.pem`));
	let theme = replace(b.mediaurlbase ?? '', /^.*\//, '') || 'bootstrap';
	w = {
		home: `${SITES}/${site}`,
		https: `0.0.0.0:${site_port} [::]:${site_port}`,
		cert: own ? `${CERTS}/${host}/fullchain.pem` : b.cert,
		key: own ? `${CERTS}/${host}/key.pem` : b.key,
		// with a site login page every login must pass through it, so the direct JSON-RPC
		// endpoint (/ubus) is switched off and LuCI uses its RPC path through cgi-bin/luci,
		// which the gate protects
		ubus: login_page ? '' : b.ubus,
		ubuspath: login_page ? '/cgi-bin/luci/admin/ubus/' : b.ubuspath,
		// no directory listings, every missing address answered by not-found (the site's own
		// 404.html with status 404), and LuCI's static files under their random name
		dirlists: '1',
		errorpage: '/cgi-bin/not-found',
		resources: `/${name}/resources`,
		media: `/${name}/${theme}`
	};
	for (let d in lsdir(SITES) ?? [])
		if (d != site) site_links(false, `${SITES}/${d}`);
	site_links(true, w.home);
	link_set(`/www/${name}`, '/www/luci-static');
}
else if (access(BACKUP) || xray_front) {
	backup_make();
	let b = backup();
	w = {
		home: b.home || '/www',
		https: b.https || '0.0.0.0:443 [::]:443',
		cert: b.cert, key: b.key,
		ubus: b.ubus || '/ubus',
		ubuspath: b.ubuspath || '/ubus/',
		dirlists: b.dirlists, errorpage: b.errorpage,
		resources: b.resourcebase || '/luci-static/resources',
		media: b.mediaurlbase || '/luci-static/bootstrap'
	};
	for (let d in lsdir(SITES) ?? []) site_links(false, `${SITES}/${d}`);
	if (access(STATIC)) link_remove(`/www/${static_name()}`);
}
if (w) {
	if (xray_front) w.https = `127.0.0.1:${BEHIND_PORT} [::1]:${BEHIND_PORT}`;
	uset('uhttpd', 'main', 'home', w.home);
	uset('uhttpd', 'main', 'cert', w.cert);
	uset('uhttpd', 'main', 'key', w.key);
	uset('uhttpd', 'main', 'listen_https', w.https, true);
	uset('uhttpd', 'main', 'ubus_prefix', w.ubus);
	uset('uhttpd', 'main', 'no_dirlists', w.dirlists);
	uset('uhttpd', 'main', 'error_page', w.errorpage);
	uset('luci', 'main', 'resourcebase', w.resources);
	uset('luci', 'main', 'mediaurlbase', w.media);
	uset('luci', 'main', 'ubuspath', w.ubuspath);
	if (changed.luci) {
		uci.commit('luci');
		for (let f in glob('/tmp/luci-indexcache*') ?? []) unlink(f);
	}
	if (!serving && !xray_front) unlink(BACKUP);
	if (changed.uhttpd) {
		uci.commit('uhttpd');
		system('sleep 2');       // let LuCI confirm its apply before the web server goes away for a moment
		system('/etc/init.d/uhttpd restart >/dev/null 2>&1');
		log(`uhttpd: home=${w.home} https=${w.https} cert=${w.cert || 'none'} login_page=${login_page ? 1 : 0} behind_xray=${xray_front ? 1 : 0}`);
	}
}

// ---------- cron: address updates, certificate renewal, the site's build schedule ----------

// five cron time fields made of digits, '*', ',', '/' and '-'
function valid_schedule(t) {
	let f = split(trim(t), /[ \t]+/);
	return length(f) == 5 && length(filter(f, x => !match(x, /^[0-9*,\/-]+$/))) == 0;
}

let wanted = [];
if (want_update) push(wanted, `*/10 * * * * ${UPDATE} # tunnel-ddns-update`);
if (want_renewal) push(wanted, '17 3 * * * /usr/libexec/tunnel-ddns/cert renew-all # tunnel-ddns-cert');
if (serving && access(`${BACKENDS}/${site}/build`, 'x') && length(schedule)) {
	if (valid_schedule(schedule)) push(wanted, `${trim(schedule)} ${SITEBUILD} ${site} # tunnel-ddns-site`);
	else log(`site schedule '${schedule}' is not a valid cron time, not scheduled`);
}
let lines = filter(split(readfile(CRONTAB) ?? '', '\n'), l => length(l));
let ours = filter(lines, l => index(l, '# tunnel-ddns-') >= 0);
if (join('\n', ours) != join('\n', wanted)) {
	let rest = [ ...filter(lines, l => index(l, '# tunnel-ddns-') < 0), ...wanted ];
	if (length(rest)) {
		mkdir('/etc/crontabs', 0o755);
		writefile(`${CRONTAB}.tdd`, join('\n', rest) + '\n');
		rename(`${CRONTAB}.tdd`, CRONTAB);
	}
	else unlink(CRONTAB);
	system('/etc/init.d/cron restart >/dev/null 2>&1');
	log(`cron: update=${want_update ? 'yes' : 'no'} cert=${want_renewal ? 'yes' : 'no'} site=${length(filter(wanted, l => index(l, 'tunnel-ddns-site') >= 0)) ? 'yes' : 'no'}`);
}

// a domain switched on gets its address at once
if (want_update) system(`setsid ${UPDATE} >/dev/null 2>&1 </dev/null &`);
