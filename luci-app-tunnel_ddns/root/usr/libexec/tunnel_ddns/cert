#!/bin/sh
# tunnel_ddns cert: Let's Encrypt certificates via acme.sh (DNS-01, no account e-mail).
#   cert issue SECTION      start issuing/renewing in the background, return at once
#   cert run SECTION        do the work (called by "issue")
#   cert renew-all          renew every certificate that is due (nightly cron job)
# State per section: /tmp/tunnel_ddns/cert-SECTION.state ("starting EPOCH" | "running EPOCH PID" | "ok EPOCH" | "failed EPOCH"),
# log: /tmp/tunnel_ddns/cert-SECTION.log

PATH=/usr/sbin:/usr/bin:/sbin:/bin
. /usr/libexec/tunnel_ddns/providers.sh

ACME=/usr/lib/acme/client/acme.sh
ACME_HOME=/etc/acme
CERTS=/etc/ssl/tunnel_ddns
RUN=/tmp/tunnel_ddns
mkdir -p "$RUN" "$ACME_HOME"

cmd="$1"
sid="$2"

case "$cmd" in
issue)
	[ -n "$sid" ] || exit 1
	echo "starting $(date +%s)" > "$RUN/cert-$sid.state"
	if command -v setsid >/dev/null 2>&1; then
		setsid "$0" run "$sid" >/dev/null 2>&1 </dev/null &
	else
		( trap '' HUP; "$0" run "$sid" >/dev/null 2>&1 </dev/null ) &
	fi
	exit 0
	;;
renew-all)
	exec "$ACME" --cron --home "$ACME_HOME" >> "$RUN/renew.log" 2>&1
	;;
run)
	[ -n "$sid" ] || exit 1
	;;
*)
	exit 1
	;;
esac

LOG="$RUN/cert-$sid.log"
STATE="$RUN/cert-$sid.state"
fail() {
	echo "$*" >> "$LOG"
	echo "failed $(date +%s)" > "$STATE"
	exit 1
}

trap '' HUP
exec 9> "$RUN/cert-$sid.lock"
flock -n 9 || exit 0

host="$(uci -q get "tunnel_ddns.$sid.hostname")"
staging="$(uci -q get "tunnel_ddns.$sid.staging")"
: > "$LOG"
echo "running $(date +%s) $$" > "$STATE"
[ -n "$host" ] || fail "No hostname configured."
tdd_provider_acme "$sid" || fail "Unknown provider."

server=letsencrypt
want=production
[ "$staging" = 1 ] && { server=letsencrypt_test; want=staging; }
force=""
conf="$ACME_HOME/${host}_ecc/$host.conf"
if [ -f "$conf" ]; then
	have=production
	grep -q 'acme-staging' "$conf" && have=staging
	[ "$have" = "$want" ] || force="--force"
fi

dnssleep=""
[ -n "$TDD_DNSSLEEP" ] && dnssleep="--dnssleep $TDD_DNSSLEEP"
attempt=1
while :; do
	echo "== $(date) issuing certificate for $host ($want server, hook $TDD_HOOK, attempt $attempt)" >> "$LOG"
	"$ACME" --issue --home "$ACME_HOME" --server "$server" --dns "$TDD_HOOK" -d "$host" \
		--keylength ec-256 $dnssleep $force >> "$LOG" 2>&1
	rc=$?
	case "$rc" in
	0|2) break ;;
	esac
	# Let's Encrypt caches a negative DNS answer for a few minutes; after a NXDOMAIN
	# failure a retry only makes sense once that cache has expired.
	if [ "$attempt" -lt 3 ] && tail -n 30 "$LOG" | grep -q "NXDOMAIN looking up TXT"; then
		echo "== $(date) Let's Encrypt did not see the record yet (negative DNS cache); waiting 6 minutes before trying again" >> "$LOG"
		attempt=$((attempt + 1))
		sleep 360
		continue
	fi
	fail "acme.sh --issue failed with exit code $rc."
done

mkdir -p "$CERTS/$host"
chmod 700 "$CERTS"
"$ACME" --install-cert --home "$ACME_HOME" -d "$host" --ecc \
	--fullchain-file "$CERTS/$host/fullchain.pem" --key-file "$CERTS/$host/key.pem" \
	--reloadcmd "/etc/init.d/uhttpd reload" >> "$LOG" 2>&1 || fail "acme.sh --install-cert failed."
chmod 600 "$CERTS/$host/key.pem"
echo "== $(date) certificate installed to $CERTS/$host/" >> "$LOG"
echo "ok $(date +%s)" > "$STATE"
/usr/libexec/tunnel_ddns/sync
exit 0
