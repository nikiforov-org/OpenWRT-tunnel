#!/bin/sh /etc/rc.common
# Background collector for the SMS archive.
#
# Arrival is found by polling, every sms.settings.poll_interval seconds (30 by
# default). There is no bus to watch on this device and no room for a permanent
# reader: the module announces new mail with an unsolicited +CMTI on the one
# control port it has, and anything sitting on that port breaks netifd's dialling.
# Each poll is one short AT session taken under the shared lock. Nothing is lost
# between polls — the card holds 100 messages, they are only noticed later.
#
# A slow maintenance tick runs alongside it for the work that is inherently
# time-based — retrying the outbox and the scheduled operator query. It re-runs
# a sync too, which costs almost nothing.
START=96
USE_PROCD=1

CTL=/usr/bin/smsctl

# Maintenance period, seconds. This is not a message poll — nothing here waits
# on new messages, so a long period costs nothing.
TICK=300

start_service() {
	# `respawn ... 0` retries indefinitely, so a poller that starts before the
	# modem has enumerated is not given up on after the default five attempts.
	procd_open_instance listener
	procd_set_param command "$CTL" listen
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance maintenance
	procd_set_param command /bin/sh -c "while :; do
		sleep $TICK
		$CTL queue-flush    >/dev/null 2>&1
		$CTL ussd-scheduled >/dev/null 2>&1
		$CTL sync           >/dev/null 2>&1
	done"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger "sms"; }
