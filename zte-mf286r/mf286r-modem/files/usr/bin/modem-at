#!/bin/sh
# Serialized access to the modem's single AT control port.
#
# The MF286R's internal module (19d2:1489, ZTE/Marvell) exposes exactly ONE
# usable control port: /dev/ttyACM0. Its other two USB serial functions answer
# nothing at all (interface 5 is ADB) — verified by binding the option driver to
# both and getting silence. So everything that talks to the modem shares that one
# port: netifd's ncm handler while dialling, the SMS back end, the modem page.
#
# Two readers on the port do not queue, they steal each other's replies. That is
# not theoretical: a single orphaned `cat /dev/ttyACM0` left behind by a debug
# session made every `gcom` call come back empty, and netifd refused to dial with
# "Failed to get modem information" until it was killed. So every access goes
# through this helper, which holds an exclusive lock for the whole exchange.
# /lib/netifd/proto/ncm.sh takes the same lock — see 90-mf286r-at-lock.
#
# Usage:  modem-at [-t <seconds>] "AT+CSQ" ["AT+COPS?" ...]
# Prints the modem's raw reply (CR stripped). Exit: 0 ok, 1 the modem answered
# ERROR, 2 the port stayed busy, 3 usage/no port.
DEV="${AT_DEV:-/dev/ttyACM0}"
LOCK=/var/lock/at-modem.lock
LOCKWAIT="${AT_LOCKWAIT:-25}"
TMO=6

while getopts t: opt; do
	case "$opt" in
		t) TMO="$OPTARG" ;;
		*) echo "usage: modem-at [-t seconds] <AT command> [...]" >&2; exit 3 ;;
	esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || { echo "usage: modem-at [-t seconds] <AT command> [...]" >&2; exit 3; }
[ -c "$DEV" ] || { echo "no modem control port at $DEV" >&2; exit 3; }

# busybox sleep takes whole seconds only; coreutils-sleep, when installed, takes
# fractions and makes a reply come back in a tenth of a second instead of a whole
# one. Probe once rather than assuming either.
if sleep 0.1 2>/dev/null; then NAP='sleep 0.1'; TICKS=10; else NAP='sleep 1'; TICKS=1; fi

mkdir -p /var/lock
exec 9>"$LOCK"
# busybox flock has no -w, so the bounded wait is a loop over the -n form.
i=0
until flock -n 9; do
	i=$((i + 1))
	[ "$i" -ge "$LOCKWAIT" ] && { echo "modem control port busy" >&2; exit 2; }
	sleep 1
done

stty -F "$DEV" raw -echo speed 115200 2>/dev/null

OUT=$(mktemp) || exit 3
CP=""
cleanup() { [ -n "$CP" ] && kill "$CP" 2>/dev/null; rm -f "$OUT"; }
trap cleanup EXIT INT TERM

rc=0
for cmd in "$@"; do
	: > "$OUT"
	cat "$DEV" > "$OUT" 2>/dev/null &
	CP=$!
	$NAP
	# Whatever arrived before we sent is somebody else's leftover — an unsolicited
	# notification, or a reply that outlived its reader — and would otherwise
	# satisfy the terminator search below and be returned as our answer. It is
	# skipped by offset rather than truncated away: `cat > file` keeps its own
	# write offset, so truncating the file under it leaves a hole and the next
	# reply comes back preceded by a run of NUL bytes, which no line anchor matches.
	skip=$(wc -c < "$OUT" 2>/dev/null || echo 0)
	printf '%s\r' "$cmd" > "$DEV"
	# Stop as soon as the modem is done instead of sleeping a fixed time: the last
	# line of any AT reply is OK, ERROR or a CME/CMS error, and ">" is the prompt
	# a message body is typed after.
	i=0; n=$((TMO * TICKS))
	while [ "$i" -lt "$n" ]; do
		tail -c "+$((skip + 1))" "$OUT" 2>/dev/null \
			| grep -qE '^(OK|ERROR|\+CME ERROR|\+CMS ERROR|>)' && break
		$NAP
		i=$((i + 1))
	done
	kill "$CP" 2>/dev/null; wait "$CP" 2>/dev/null; CP=""
	reply=$(tail -c "+$((skip + 1))" "$OUT" 2>/dev/null)
	printf '%s\n' "$reply" | tr -d '\r'
	printf '%s\n' "$reply" | grep -qE '^(ERROR|\+CME ERROR|\+CMS ERROR)' && rc=1
done
exit "$rc"
