#!/usr/bin/env ucode
// xray-service start|stop CONFIG: the one xray process of luci-app-xtunnel. The server and the client
// each generate their own xray configuration file and run this script from their init script:
// "start" after their sync, "stop" when they stop. The files of the started parts are joined into
// /tmp/xtunnel-xray/config.json (inbounds and routing rules added up, every rule bound to the inbounds
// of its part; outbounds and balancers by tag, "direct" first; the other sections from the file that
// has them; xray's own merging of several -config files replaces the routing rules of the first file,
// so it is not used) and xray runs with it as the procd service "xtunnel-xray": started, restarted
// when the joined file changed, removed when no file is left. A joined file of two files replaces the
// one in effect only after "xray run -test" accepts it (a single file was tested by its part's sync).
// After xray started with the client's file, the client's active link is applied again through
// xray's control socket (select) and the links are measured (measure started).

'use strict';

import { access, readfile, writefile, mkdir, unlink, chmod } from 'fs';
import { XRAY, log, lock, read_json, ubus, instances, replace_checked, xray_test, spawn } from 'xtunnel.common';

const SERVICE = 'xtunnel-xray';
const DIR     = '/tmp/xtunnel-xray';
const CONF    = `${DIR}/config.json`;
const ERROR   = `${DIR}/error`;
const STARTED = `${DIR}/started`;    // the files of the started packages
const LIST    = `${DIR}/parts`;      // the files in the joined file in effect, for the status pages
const ASSETS  = '/etc/xtunnel-client/sources';   // the .dat files of the client's lists (ext: rules)
const CONTROL = `${DIR}/control.sock`;           // the client's active link: xray control bo|bi (select)
const LOCK    = '/var/lock/xtunnel-xray';
const PARTS   = [
	{ conf: '/etc/xtunnel-server/config.json' },
	{ conf: '/etc/xtunnel-client/config.json', after: '/usr/libexec/xtunnel-client/measure started' }
];


// the configurations joined, or { error }
function join_configs(configs) {
	let out = { inbounds: [], outbounds: [], routing: { domainStrategy: 'AsIs', rules: [], balancers: [] } };
	let seen_in = {}, seen_out = {}, seen_bal = {};
	for (let c in configs) {
		for (let k, v in c) {
			// the portals of the server and the bridges of the client
			if (k == 'reverse') {
				out.reverse ??= {};
				for (let kk in [ 'bridges', 'portals' ])
					if (length(v[kk] ?? [])) out.reverse[kk] = [ ...(out.reverse[kk] ?? []), ...v[kk] ];
				continue;
			}
			if (!(k in [ 'inbounds', 'outbounds', 'routing' ]) && !exists(out, k)) out[k] = v;
		}
		for (let ib in c.inbounds ?? []) {
			if (ib.tag && seen_in[ib.tag]) return { error: `the inbound tag "${ib.tag}" is used by two packages` };
			seen_in[ib.tag] = true;
			push(out.inbounds, ib);
		}
		for (let ob in c.outbounds ?? [])
			if (!seen_out[ob.tag]) { seen_out[ob.tag] = true; push(out.outbounds, ob); }
		for (let r in c.routing?.rules ?? []) push(out.routing.rules, r);
		for (let b in c.routing?.balancers ?? [])
			if (!seen_bal[b.tag]) { seen_bal[b.tag] = true; push(out.routing.balancers, b); }
	}
	// the outbound for anything no rule takes: "direct", as in each package's own file
	out.outbounds = [ ...filter(out.outbounds, o => o.tag == 'direct'), ...filter(out.outbounds, o => o.tag != 'direct') ];
	return { config: out };
}

let op = ARGV[0], arg = ARGV[1];
if (!(op in [ 'start', 'stop' ]) || !length(filter(PARTS, p => p.conf == arg))) {
	warn('usage: xray-service start|stop CONFIG\n');
	exit(2);
}
mkdir(DIR, 0o700);
// the processes started from here (the command after a start) do not hold the lock
let held = lock(LOCK, true);

let started = filter(split(readfile(STARTED) ?? '', '\n'), c => length(filter(PARTS, p => p.conf == c)));
if (op == 'start' && !(arg in started)) push(started, arg);
if (op == 'stop') started = filter(started, c => c != arg);
writefile(STARTED, length(started) ? join('\n', started) + '\n' : '');

let configs = [], used = [];
for (let p in PARTS) {
	let c = (p.conf in started) ? read_json(p.conf, null) : null;
	if (c) { push(configs, c); push(used, p); }
}
let before = instances(SERVICE).xray;
let command = [ XRAY, 'run', '-config', CONF ];

if (!length(configs) || !access(XRAY, 'x')) {
	if (before) ubus().call('service', 'delete', { name: SERVICE });
	unlink(CONF);
	unlink(ERROR);
	unlink(LIST);
	exit(0);
}
let j = join_configs(configs), replaced = false;
if (!j.error) {
	// a joined file of two parts replaces the one in effect after xray accepts it (one part was tested by its sync)
	let r = replace_checked(CONF, sprintf('%J\n', j.config), 0o600, (length(configs) > 1) ? (f => xray_test(f, `XRAY_LOCATION_ASSET=${ASSETS}`)) : null);
	if (r == 'written') replaced = true;
	else if (r != 'same') j.error = `xray rejected the joined configuration: ${r}`;
}
if (j.error) {
	writefile(ERROR, `${j.error}\n`);
	log('xtunnel-xray', `not applied: ${j.error}`);
}
if (!j.error) {
	writefile(LIST, join('\n', map(used, p => p.conf)) + '\n');
	unlink(ERROR);
}
if (!access(CONF)) exit(1);

ubus().call('service', 'set', {
	name: SERVICE,
	instances: {
		xray: {
			command: command,
			env: { XRAY_LOCATION_ASSET: ASSETS, XTUNNEL_CONTROL: CONTROL },
			file: [ CONF, XRAY ],          // a changed file restarts xray at the next service set (an upgrade)
			respawn: [ '3600', '5', '5' ],
			limits: { nofile: '16384 16384' },
			stderr: true
		}
	}
});
// procd starts the new process once the old one has exited: the command after a start waits for
// a new pid (at most 10 seconds) in the background
if (replaced || !before?.running || join(' ', before?.command ?? []) != join(' ', command)) {
	let old = before?.running ? before.pid : 0;
	for (let p in used)
		if (p.after && access(split(p.after, ' ')[0], 'x'))
			spawn(`i=0; while [ $i -lt 10 ] && [ "$(ubus call service list '{"name":"${SERVICE}"}' 2>/dev/null | jsonfilter -e '@[*].instances.xray.pid')" = "${old}" ]; do sleep 1; i=$((i+1)); done; ${p.after}`);
}
