#!/usr/bin/env ucode
// xtunnel-ddns dns01 METHOD TYPE IDENT TOKEN AUTH: the challenge hook uacme runs (see cert).
// Only dns-01 is accepted (another TYPE: exit 1, uacme then tries the next one). "begin" puts the
// TXT record _acme-challenge.IDENT = AUTH at the provider of the domain section TDD_SECTION and
// waits until every authoritative name server of the zone answers with it (at most 7 minutes;
// a public resolver could keep a negative answer longer; when none of the name servers answers
// queries from here, two minutes instead: Beget's name servers took 30 s to more than a minute to
// publish a record, and after an NXDOMAIN Let's Encrypt is asked again only 6 minutes later);
// "done" and "failed" remove it.

'use strict';

import { popen } from 'fs';
import { cursor } from 'uci';
import { provider } from 'xtunnel-ddns.providers';
import { name_servers } from 'xtunnel-ddns.dns';

const WAIT_MAX = 420;
const WAIT_BLIND = 120;

function shq(s) { return "'" + replace(`${s ?? ''}`, "'", "'\\''") + "'"; }

function exec(cmd) {
	let p = popen(cmd, 'r');
	if (!p) return '';
	let out = p.read('all') ?? '';
	p.close();
	return out;
}

function say(msg) { print(`dns01: ${msg}\n`); }

// { all: every name server answers with the value, reached: how many answered at all }
function lookup_all(fqdn, value, ns) {
	let all = true, reached = 0;
	for (let s in ns) {
		let out = exec(`nslookup -type=txt ${shq(fqdn)} ${shq(s)} 2>&1`);
		if (index(out, 'no servers could be reached') < 0 && index(out, 'timed out') < 0) reached++;
		if (index(out, value) < 0) all = false;
	}
	return { all: all, reached: reached };
}

let method = ARGV[0], kind = ARGV[1], ident = lc(ARGV[2] ?? ''), auth = ARGV[4] ?? '';
if (kind != 'dns-01') exit(1);

let uci = cursor();
uci.load('xtunnel-ddns');
let section = uci.get_all('xtunnel-ddns', getenv('TDD_SECTION') ?? '');
let p = provider(section);
if (!p || lc(section.hostname ?? '') != ident) {
	say(`no domain section with the provider settings for ${ident}`);
	exit(1);
}
let fqdn = `_acme-challenge.${ident}`;

if (method == 'begin') {
	let r = p.txt_add(fqdn, auth);
	if (!r.ok) {
		say(`adding the TXT record ${fqdn} failed: ${r.message}`);
		exit(1);
	}
	say(`TXT record ${fqdn} added`);
	let z = name_servers(ident);
	if (!z) {
		say('the name servers of the zone were not found, not waiting for the record to spread');
		exit(0);
	}
	say(`waiting until all name servers of ${z.zone} answer with it: ${join(' ', z.ns)}`);
	let deadline = time() + WAIT_MAX;
	while (time() < deadline) {
		let r = lookup_all(fqdn, auth, z.ns);
		if (r.all) {
			say('the record is visible on all name servers');
			exit(0);
		}
		if (!r.reached) {
			say(`none of the name servers answers queries from here; waiting ${WAIT_BLIND} seconds instead`);
			system(`sleep ${WAIT_BLIND}`);
			exit(0);
		}
		system('sleep 10');
	}
	say(`gave up waiting after ${WAIT_MAX / 60} minutes, continuing anyway`);
	exit(0);
}
if (method == 'done' || method == 'failed') {
	let r = p.txt_remove(fqdn, auth);
	say(r.ok ? `TXT record ${fqdn} removed` : `removing the TXT record ${fqdn} failed: ${r.message}`);
	exit(0);
}
exit(1);
