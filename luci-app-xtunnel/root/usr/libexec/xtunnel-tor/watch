#!/usr/bin/env ucode
// xtunnel-tor watch: keeps the snowflake bridges as the fallback. Runs every two minutes from cron
// while the bridge list has snowflake lines and other lines and the snowflake mode is "fallback".
// Asks the running tor through its control port (127.0.0.1, port file and cookie as written by the
// configuration in effect) whether it has a working circuit and through which bridges its circuits go.
//   no working circuit for DOWN_MINUTES while the router has a default route: the snowflake lines are
//     added (the marker snowflake.on, then sync restarts tor)
//   with the snowflake lines added, circuits through the other bridges for RETURN_MINUTES, or the
//     marker older than RETRY_HOURS: the other bridges are tried alone again (marker removed, sync)
// bridges-update removes the marker too when the daily update brought a changed list.
// While tor runs on the list shipped with the package (no refreshed list yet) and has a working
// circuit, bridges-update runs now instead of at its daily time, through that circuit; after a failed
// attempt again FIRST_RETRY minutes later (cron runs this script for that also outside the fallback).
// watch reconnect REASON (from the hotplug script, an interface of the wan zone came up or went
// down): when the route to the Internet now leaves through another interface or address, tor's
// connections are still bound to the old address and stay silent until tor notices (measured:
// 7 minutes after the WAN cable was pulled, more than 8 after it was plugged back), so tor is told
// DisableNetwork 1 and 0: it closes them and connects again through the route in effect.
// Talks to tor only on 127.0.0.1: no traffic of its own.

'use strict';

import { access, readfile, writefile, mkdir, unlink, stat } from 'fs';
import { cursor } from 'uci';
import { exec, log, read_json, locked, running } from 'xtunnel.common';
import { control } from 'xtunnel-tor.common';

const CFG       = 'xtunnel-tor';
const DIR       = '/etc/xtunnel-tor';
const CONF      = `${DIR}/torrc`;
const RUN       = '/tmp/xtunnel-tor';
const STATE     = `${RUN}/watch.json`;
const UPLINK    = `${RUN}/uplink`;
const FALLBACK  = `${DIR}/snowflake.on`;
const SYNC      = '/usr/libexec/xtunnel-tor/sync';
const LIST      = `${DIR}/bridges.txt`;
const BSTATE    = `${DIR}/bridges.state`;
const BLOCK     = `${RUN}/bridges.lock`;         // held while bridges-update runs
const UPDATE    = '/usr/libexec/xtunnel-tor/bridges-update';
const DOWN_MINUTES   = 6;
const RETURN_MINUTES = 30;
const RETRY_HOURS    = 24;
const FIRST_RETRY    = 30;

// a default route in the kernel's tables (busybox ip does not filter by "default"); IPv6 unreachable
// routes are on lo
function default_route() {
	for (let l in split(readfile('/proc/net/route') ?? '', '\n')) {
		let f = split(trim(l), /[ \t]+/);
		if (length(f) > 7 && f[1] == '00000000' && f[7] == '00000000') return true;
	}
	for (let l in split(readfile('/proc/net/ipv6_route') ?? '', '\n')) {
		let f = split(trim(l), /[ \t]+/);
		if (length(f) > 9 && f[0] == '00000000000000000000000000000000' && f[1] == '00' && f[9] != 'lo') return true;
	}
	return false;
}

// { established, liveness, bootstrap, built, first_hops } from tor's control port, or null when tor does
// not answer
function ask_tor() {
	let out = control([ 'GETINFO status/circuit-established network-liveness status/bootstrap-phase circuit-status' ]) ?? '';
	let e = match(out, /status\/circuit-established=([01])/), l = match(out, /network-liveness=([a-z]+)/);
	let b = match(out, /PROGRESS=([0-9]+)/);
	if (!e) return null;
	let hops = [];
	for (let line in split(out, '\n')) {
		let c = match(line, /^[0-9]+ BUILT \$([0-9A-Fa-f]{40})/);
		if (c) push(hops, uc(c[1]));
	}
	return { established: (e[1] == '1'), liveness: l ? l[1] : '', bootstrap: b ? int(b[1]) : 0, built: length(hops), first_hops: uniq(hops) };
}

// the interface and source address of the route to the Internet in effect ("" without one)
function route_key() {
	let out = exec('ip route get 192.0.2.1 2>/dev/null').out;
	let d = match(out, /dev ([^ \n]+)/), s = match(out, /src ([^ \n]+)/);
	return d ? d[1] + (s ? ' ' + s[1] : '') : '';
}

let uci = cursor();
uci.load('xtunnel-server');
let main = uci.get_all('xtunnel-server', 'tor') ?? {};
if (access(CONF) != true) exit(0);                 // tor does not run with this package's file

// the configuration in effect: the transport of each bridge
let conf = readfile(CONF) ?? '';

if (ARGV[0] == 'reconnect') {
	mkdir(RUN, 0o755);
	let now = route_key(), before = trim(readfile(UPLINK) ?? '');
	writefile(UPLINK, `${now}\n`);
	if (now == before || !running('tor')) exit(0);
	let out = control([ 'SETCONF DisableNetwork=1', 'SETCONF DisableNetwork=0', 'GETCONF DisableNetwork' ]);
	log(CFG, `${ARGV[1] ?? 'uplink'}: the route to the Internet leaves through ${now || 'no interface'}` + (length(before) ? ` (was ${before})` : '') +
	    ((out != null && index(out, '250 DisableNetwork=0') >= 0) ? ', tor closed its connections and connects again' : ', tor did not answer on its control port'));
	exit(0);
}

// the first bridge update (see above): the list shipped with the package in use, a working circuit,
// no attempt in the last FIRST_RETRY minutes (its time is in bridges.state) and none running
function first_update(t) {
	if ((main.bridges ?? 'builtin') != 'builtin' || match(lc(trim(main.bridge_country ?? '')), /^[a-z][a-z]$/) == null) return;
	if (length(trim(readfile(LIST) ?? ''))) return;
	if (t == null || !t.established || t.built == 0) return;
	let last = read_json(BSTATE, {}).time;
	let age = time() - (last ?? 0);
	if (last && age >= 0 && age < FIRST_RETRY * 60) return;
	if (locked(BLOCK)) return;
	log(CFG, 'bridges: tor runs on the list shipped with the package and has a circuit: the bridge update runs now');
	system(`setsid ${UPDATE} </dev/null >/dev/null 2>&1 &`);
}

if (!running('tor')) exit(0);
let t = ask_tor();
first_update(t);
if ((main.snowflake ?? 'fallback') != 'fallback') exit(0);
let kind = {};
for (let l in split(conf, '\n')) {
	let b = match(l, /^Bridge (([a-z0-9_]+) )?[^ ]+:[0-9]+ ([0-9A-Fa-f]{40})/);
	if (b) kind[uc(b[3])] = b[2] ?? 'vanilla';
}

mkdir(RUN, 0o755);
let st = read_json(STATE, {});
let now = time();
let prev = (type(st.tor) == 'object') ? st.tor.bootstrap : null;
// working: a completed circuit, the network live (tor saw cells recently) and built circuits (an onion
// service keeps its introduction circuits; connections refused or reset close them)
let working = (t != null && t.established && t.liveness != 'down' && t.built > 0);
// a bootstrap that advanced since the last check (a slow first download of the directory) counts as working
let progress = (t != null && prev != null && t.bootstrap > prev);
let via_other = (t != null && length(filter(t.first_hops, fp => kind[fp] != null && kind[fp] != 'snowflake')) > 0);
st.time = now;
st.tor = t;
st.uplink = default_route();
st.via_other = via_other;

function save() { writefile(STATE, sprintf('%J\n', st)); }

function apply(msg) {
	log(CFG, msg);
	delete st.down_since;
	delete st.other_since;
	save();
	system(SYNC);
	exit(0);
}

let since = null;
if (access(FALLBACK) == true) {
	since = int(trim(readfile(FALLBACK) ?? ''));
	if (!(since > 0)) since = stat(FALLBACK)?.mtime ?? now;
}
if (since == null) {
	delete st.other_since;
	if (working || progress || !st.uplink)
		delete st.down_since;                       // a circuit works, or no uplink at all: not the bridges
	else {
		st.down_since ??= now;
		if (now - st.down_since >= DOWN_MINUTES * 60) {
			writefile(FALLBACK, `${now}\n`);
			apply(`no working circuit through the bridges for ${int((now - st.down_since) / 60)} minutes: snowflake bridges added`);
		}
	}
}
else {
	delete st.down_since;
	if (working && via_other) {
		st.other_since ??= now;
		if (now - st.other_since >= RETURN_MINUTES * 60) {
			unlink(FALLBACK);
			apply(`circuits through the other bridges for ${RETURN_MINUTES} minutes: snowflake bridges held back again`);
		}
	}
	else
		delete st.other_since;
	if (now - since >= RETRY_HOURS * 3600) {
		unlink(FALLBACK);
		apply(`snowflake bridges added ${RETRY_HOURS} hours ago: the other bridges are tried alone again`);
	}
}
save();
