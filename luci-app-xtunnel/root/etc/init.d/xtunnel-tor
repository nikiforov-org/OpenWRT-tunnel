#!/bin/sh /etc/rc.common
# Applies the Tor settings of /etc/config/xtunnel-server (section "tor": the connection to the Tor
# network and the onion service with the server profiles as its clients) and the client keys of the
# links through Tor of /etc/config/xtunnel-client: the stock tor service with this package's
# configuration file appended through tor.conf.tail_include, while the onion service or the client's
# links need tor.

START=96
USE_PROCD=1

start_service() {
	/usr/libexec/xtunnel-tor/sync
}

reload_service() {
	/usr/libexec/xtunnel-tor/sync
}

service_triggers() {
	procd_add_reload_trigger "xtunnel-server" "xtunnel-client"
}
