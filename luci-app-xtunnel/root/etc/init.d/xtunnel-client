#!/bin/sh /etc/rc.common
# Applies /etc/config/xtunnel-client: sync generates the xray configuration that intercepts the LAN
# (TPROXY) and sends it to the active link or directly by the list (the links of the profiles are
# the clients), then xray-service runs xray with it and with the configuration of
# the server while the server is started, as one process (the procd service
# "xtunnel-xray"), and applies the active link through xray's API (select) after every start of
# xray. LuCI's apply triggers a reload: procd restarts xray only when a file changed; with the
# client off its file is removed.

START=97
USE_PROCD=1

start_service() {
	/usr/libexec/xtunnel-client/sync
	/usr/libexec/xtunnel/xray-service start /etc/xtunnel-client/config.json
}

stop_service() {
	/usr/libexec/xtunnel/xray-service stop /etc/xtunnel-client/config.json
}

service_triggers() {
	procd_add_reload_trigger "xtunnel-client"
}
