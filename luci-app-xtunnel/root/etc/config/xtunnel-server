config xtunnel-server 'main'
	option enabled '0'
	option target '127.0.0.1:443'
	option local_access '1'
	option vision_enabled '1'
	option vision_port '443'
	option xhttp_enabled '0'
	option xhttp_port '8443'
	option xhttp_mode 'auto'
	option hysteria2_enabled '0'
	option hysteria2_port '443'
	option cert_source 'ddns'

config tor 'tor'
	option enabled '0'
	option bridges 'builtin'
	option snowflake 'fallback'
	option persistent_cache '0'
	option reduced_padding '0'
	list port '22'
	list port '80'
	list port '443'
	list port '8443'
