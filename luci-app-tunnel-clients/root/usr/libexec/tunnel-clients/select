#!/bin/sh
# select [TAG]: makes TAG the active client of the running xray (balancer "active", through its API,
# without a restart). Without an argument: the configured client (manual mode) or the last automatic
# choice. Waits up to 30 s for the API after a start. Prints nothing; logs a switch.
API=127.0.0.1:61085
TAG="$1"
if [ -z "$TAG" ]; then
	if [ "$(uci -q get tunnel-clients.main.mode)" = manual ]; then
		TAG="$(uci -q get tunnel-clients.main.active)"
	else
		TAG="$(jsonfilter -i /etc/tunnel-clients/auto.json -e '@.active' 2>/dev/null)"
	fi
fi
[ -n "$TAG" ] || exit 0
# the current choice: the override if one is set, else the balancer's own selection
current() {
	xray api bi --server=$API active 2>/dev/null | awk '
		/Selecting Override:/ { sec = "o"; next }
		/Selects:/            { sec = "s"; next }
		/^[ \t]*[0-9]+[ \t]+/ { if (sec == "o" && o == "") o = $2; if (sec == "s" && s == "") s = $2 }
		END { print (o != "") ? o : s }'
}
NOW=""
for i in $(seq 1 30); do
	NOW="$(current)"
	[ -n "$NOW" ] && break
	sleep 1
done
[ -n "$NOW" ] || exit 1
[ "$NOW" = "$TAG" ] && exit 0
if xray api bo --server=$API -b active "$TAG" >/dev/null 2>&1 && [ "$(current)" = "$TAG" ]; then
	logger -t tunnel-clients "active client: $TAG"
else
	logger -t tunnel-clients "could not make $TAG the active client"
	exit 1
fi
