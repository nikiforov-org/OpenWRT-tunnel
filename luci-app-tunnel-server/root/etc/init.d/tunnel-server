#!/bin/sh /etc/rc.common
# Applies /etc/config/tunnel-server: sync generates the xray configuration of the enabled
# transports (TCP + XTLS-Vision, XHTTP, Hysteria2), then xray-service runs xray with it and with
# the configuration of luci-app-tunnel-client while that one is started, as one process (the procd
# service "tunnel-xray"). LuCI's apply triggers a reload: procd restarts xray only when a file
# changed; with the server switched off its file is removed.

START=99
USE_PROCD=1

start_service() {
	# the instance of earlier versions, before the process was shared
	ubus call service delete '{"name":"tunnel-server","instance":"xray"}' >/dev/null 2>&1
	/usr/libexec/tunnel-server/sync
	/usr/libexec/tunnel-server/xray-service start /etc/tunnel-server/config.json
}

stop_service() {
	/usr/libexec/tunnel-server/xray-service stop /etc/tunnel-server/config.json
}

service_triggers() {
	procd_add_reload_trigger "tunnel-server"
}
