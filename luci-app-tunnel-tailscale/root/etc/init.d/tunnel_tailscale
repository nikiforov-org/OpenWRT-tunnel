#!/bin/sh /etc/rc.common
# Applies /etc/config/tunnel_tailscale to the system: the stock tailscale service, the node's
# preferences ("tailscale up") and the firewall zone for the tailscale0 interface.

START=96
USE_PROCD=1

start_service() {
	/usr/libexec/tunnel_tailscale/sync
}

reload_service() {
	/usr/libexec/tunnel_tailscale/sync
}

service_triggers() {
	procd_add_reload_trigger "tunnel_tailscale"
}
