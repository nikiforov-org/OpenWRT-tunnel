#!/usr/bin/env ucode
// tunnel_tailscale sync: make the system match /etc/config/tunnel_tailscale.
//   sync          apply (idempotent): the stock tailscale service, the node's preferences
//                 through "tailscale up", the firewall zone for tailscale0
//   sync revert   undo everything the package configured (used when the package is removed)
// Logging in needs either an auth key in the settings or the login link from the page; until
// then the preferences cannot be applied and the reason is kept in /tmp/tunnel_tailscale/error.

'use strict';

import { access, popen, readfile, writefile, mkdir, unlink, chmod } from 'fs';
import { cursor } from 'uci';

const CFG   = 'tunnel_tailscale';
const RUN   = '/tmp/tunnel_tailscale';
const ERROR = `${RUN}/error`;
const TS    = '/usr/sbin/tailscale';
const ZONE  = 'tunnel_tailscale';
const FWD   = { wan: 'tunnel_tailscale_wan', lan: 'tunnel_tailscale_lan', from_lan: 'tunnel_tailscale_from_lan' };
const MANAGED = '/etc/tunnel_tailscale/managed';   // exists while this package runs the stock service

const mode = ARGV[0] ?? 'apply';

function shq(s) {
	return "'" + replace(`${s ?? ''}`, "'", "'\\''") + "'";
}

function exec(command) {
	let p = popen(command, 'r');
	if (p == null)
		return { code: -1, out: '' };
	let out = p.read('all') ?? '';
	return { code: p.close(), out: out };
}

function log(msg) {
	system(`logger -t ${CFG} ${shq(msg)}`);
}

function flag(v, dflt) {
	return (v == null || v == '') ? dflt : (v == '1');
}

function list(v) {
	if (type(v) == 'array') return v;
	return (v == null || v == '') ? [] : [ v ];
}

function uset(uci, cfg, sec, opt, val) {
	let cur = uci.get(cfg, sec, opt);
	let same = (type(val) == 'array') ? (type(cur) == 'array' ? join(' ', cur) == join(' ', val) : (length(val) == 1 && cur == val[0])) : (cur == val);
	if (same) return false;
	uci.set(cfg, sec, opt, val);
	return true;
}

function set_error(msg) {
	mkdir(RUN, 0o755);
	writefile(ERROR, msg);
	log(`not applied: ${msg}`);
}

// the LAN subnet in CIDR form, from network.lan (ipaddr with or without a prefix, netmask)
function lan_subnet() {
	let uci = cursor();
	uci.load('network');
	let ip = uci.get('network', 'lan', 'ipaddr');
	if (type(ip) == 'array') ip = ip[0];
	if (!ip) return '';
	let prefix = 24;
	let m = match(ip, /^([0-9.]+)\/([0-9]+)$/);
	if (m) { ip = m[1]; prefix = int(m[2]); }
	else {
		let mask = uci.get('network', 'lan', 'netmask');
		if (mask) {
			let bits = 0;
			for (let o in split(mask, '.')) { let v = int(o); while (v & 0x80) { bits++; v = (v << 1) & 0xff; } }
			prefix = bits;
		}
	}
	let o = map(split(ip, '.'), x => int(x));
	if (length(o) != 4) return '';
	let n = ((o[0] << 24) | (o[1] << 16) | (o[2] << 8) | o[3]) & 0xffffffff;
	let maskv = prefix == 0 ? 0 : ((0xffffffff << (32 - prefix)) & 0xffffffff);
	n &= maskv;
	return sprintf('%d.%d.%d.%d/%d', (n >> 24) & 255, (n >> 16) & 255, (n >> 8) & 255, n & 255, prefix);
}

function backend_state() {
	for (let i = 0; i < 10; i++) {
		let r = exec(`${TS} status --json 2>/dev/null`);
		let j; try { j = json(r.out); } catch (e) { j = null; }
		if (j?.BackendState) return j.BackendState;
		system('sleep 1');
	}
	return '';
}

// ---- the stock tailscale service ----

function sync_service(enabled) {
	// switched off here and never switched on here: the stock service is left alone
	if (!enabled && access(MANAGED) != true)
		return true;
	let uci = cursor();
	if (!uci.load('tailscale')) {
		set_error('the tailscale package is not installed (/etc/config/tailscale is missing)');
		return false;
	}
	let changed = false;
	if (uci.get('tailscale', 'settings') != 'settings') { uci.set('tailscale', 'settings', 'settings'); changed = true; }
	changed = uset(uci, 'tailscale', 'settings', 'fw_mode', 'nftables') || changed;
	if (changed) uci.commit('tailscale');
	if (enabled) {
		mkdir('/etc/tunnel_tailscale', 0o755);
		writefile(MANAGED, '');
		system('/etc/init.d/tailscale enable >/dev/null 2>&1');
		if (changed || exec('pidof tailscaled >/dev/null 2>&1').code != 0) {
			system('/etc/init.d/tailscale restart >/dev/null 2>&1');
			log('tailscale service started');
		}
	}
	else {
		if (exec('pidof tailscaled >/dev/null 2>&1').code == 0)
			exec(`${TS} down 2>/dev/null`);
		system('/etc/init.d/tailscale stop >/dev/null 2>&1; /etc/init.d/tailscale disable >/dev/null 2>&1');
		unlink(MANAGED);
		log('tailscale service stopped');
	}
	return true;
}

// ---- the node's preferences ----

function apply_prefs(main) {
	let state = backend_state();
	if (!state) { set_error('tailscaled does not answer'); return; }
	let routes = list(main.advertise_routes);
	if (!length(routes) && flag(main.advertise_lan, true)) {
		let lan = lan_subnet();
		if (lan) routes = [ lan ];
	}
	let host = trim(main.hostname ?? '') || trim(readfile('/proc/sys/kernel/hostname') ?? '') || 'router';
	let args = [ '--reset', '--netfilter-mode=off', '--timeout=45s',
		`--hostname=${shq(host)}`,
		`--advertise-exit-node=${flag(main.advertise_exit_node, true)}`,
		`--advertise-routes=${shq(join(',', routes))}`,
		`--accept-routes=${flag(main.accept_routes, false)}`,
		`--accept-dns=${flag(main.accept_dns, false)}`,
		`--ssh=${flag(main.ssh, false)}`,
		`--shields-up=${flag(main.shields_up, false)}` ];
	if (state == 'NeedsLogin' || state == 'NoState') {
		let key = trim(main.auth_key ?? '');
		if (!key) {
			set_error('not logged in: enter an auth key or use "Get login link" on the page');
			return;
		}
		push(args, `--auth-key=${shq(key)}`);
	}
	let r = exec(`${TS} up ${join(' ', args)} 2>&1`);
	if (r.code != 0) {
		let lines = split(rtrim(r.out, '\n'), '\n');
		set_error('tailscale up: ' + trim(lines[length(lines) - 1] ?? ''));
		return;
	}
	log(`preferences applied: hostname ${host}, exit node ${flag(main.advertise_exit_node, true)}, routes ${length(routes) ? join(',', routes) : 'none'}`);
}

// ---- firewall: a zone for tailscale0 ----

function sync_firewall(enabled, local_access) {
	let uci = cursor();
	uci.load('firewall');
	let changed = false;
	if (enabled) {
		if (uci.get('firewall', ZONE) != 'zone') { uci.set('firewall', ZONE, 'zone'); changed = true; }
		changed = uset(uci, 'firewall', ZONE, 'name', ZONE) || changed;
		changed = uset(uci, 'firewall', ZONE, 'device', [ 'tailscale0' ]) || changed;
		changed = uset(uci, 'firewall', ZONE, 'input', local_access ? 'ACCEPT' : 'REJECT') || changed;
		changed = uset(uci, 'firewall', ZONE, 'output', 'ACCEPT') || changed;
		changed = uset(uci, 'firewall', ZONE, 'forward', 'REJECT') || changed;
		changed = uset(uci, 'firewall', ZONE, 'mtu_fix', '1') || changed;
		let want = { wan: true, lan: local_access, from_lan: local_access };
		for (let key, sec in FWD) {
			if (want[key]) {
				if (uci.get('firewall', sec) != 'forwarding') { uci.set('firewall', sec, 'forwarding'); changed = true; }
				changed = uset(uci, 'firewall', sec, 'src', key == 'from_lan' ? 'lan' : ZONE) || changed;
				changed = uset(uci, 'firewall', sec, 'dest', key == 'from_lan' ? ZONE : key) || changed;
			}
			else if (uci.get('firewall', sec) == 'forwarding') {
				uci.delete('firewall', sec);
				changed = true;
			}
		}
	}
	else {
		for (let key, sec in FWD)
			if (uci.get('firewall', sec) == 'forwarding') { uci.delete('firewall', sec); changed = true; }
		if (uci.get('firewall', ZONE) == 'zone') { uci.delete('firewall', ZONE); changed = true; }
	}
	if (!changed) return;
	uci.commit('firewall');
	system('/etc/init.d/firewall reload >/dev/null 2>&1');
	log(`firewall zone ${ZONE}: ${enabled ? (local_access ? 'router and LAN reachable, exit to WAN' : 'exit to WAN only') : 'removed'}`);
}

// ---- main ----

let uci = cursor();
uci.load(CFG);
let main = uci.get_all(CFG, 'main') ?? {};
chmod(`/etc/config/${CFG}`, 0o600);
unlink(ERROR);

let enabled = (mode == 'apply' && flag(main.enabled, false));
if (enabled && access(TS, 'x') != true) {
	set_error('the tailscale package is not installed (/usr/sbin/tailscale is missing)');
	enabled = false;
}
if (sync_service(enabled)) {
	sync_firewall(enabled, flag(main.local_access, true));
	if (enabled)
		apply_prefs(main);
}
