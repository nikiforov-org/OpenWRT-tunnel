#!/usr/bin/env ucode
// measure [now|health|started]: speed and latency of the links, recorded in /tmp/tunnel-client/
// measure.json and history.json. Each link has its own local tap in xray (a fixed forward to the
// test host through that link only); the links are measured one after the other, so that none
// shares the way out with another. The test is a download of test_bytes from the server's own site
// through the tunnel, https://127.0.0.1/cgi-bin/speed?bytes=N (the site of luci-app-tunnel-ddns
// serves it), or from the URL a profile names, cut off after test_bytes.
//   (none)   from cron: only in the automatic mode with two links or more, and not while the route
//            to the Internet goes through an interface of the "metered" list (only this periodic
//            measurement is held there); the fastest link
//            becomes active when it beats the current one by the threshold, or at once when the
//            current one failed
//   now      the same at once, in every mode and on every uplink (the page's button); a link chosen
//            by hand stays
//   health   from cron every minute in the automatic mode with two links or more: the active link
//            gets a small request (HEAD, or one byte from the default target), any HTTP answer will
//            do; when none comes, the other links get the same request and the one that answers
//            first becomes active. While the measurement after a start is pending, it is made instead.
//   started  after every start of xray (xray-service): the choice is applied (select), then, in the
//            automatic mode with two links or more, all links are measured as from cron, also on a
//            metered uplink. Without a route to the Internet yet (at boot) the minute check makes
//            it once one exists, and again every minute while no link answers (the marker
//            measure.pending).

'use strict';

import { access, readfile, writefile, mkdir, unlink } from 'fs';
import { cursor } from 'uci';
import { RUN, shq, exec, lock, instance, active_link, uplink } from 'tunnel-client.common';

const CFG    = 'tunnel-client';
const STATE  = `${RUN}/state.json`;
const OUT    = `${RUN}/measure.json`;
const HIST   = `${RUN}/history.json`;
const LOCK   = `${RUN}/measure.lock`;
const PENDING = `${RUN}/measure.pending`;     // the measurement after a start, not made yet
const AUTO   = '/etc/tunnel-client/auto.json';
const SELECT = '/usr/libexec/tunnel-client/select';
const HISTORY = 24;
const FMT    = '%{http_code} %{size_download} %{time_total} %{time_starttransfer} %{speed_download} %{errormsg}';

function log(msg) { system(`logger -t ${CFG} ${shq(msg)}`); }

function read_json(path, dflt) {
	let v = null;
	try { v = json(readfile(path) ?? ''); } catch (e) { v = null; }
	return (type(v) == type(dflt)) ? v : dflt;
}

function list(v) {
	if (type(v) == 'array') return v;
	return (v == null || v == '') ? [] : [ v ];
}

// whether the route to the Internet goes through an interface of the "metered" list
function metered_uplink(main) {
	let want = list(main.metered);
	return length(want) > 0 && (uplink() in want);
}

// one curl through the tap of a link; the URL's host keeps its name for TLS. small: a request with
// a small answer (HEAD to the link's own URL, one byte from the default target)
function curl_cmd(c, bytes, timeout, small, out) {
	if (!length(c.test_url))
		return `curl -sk -m ${timeout} -o /dev/null -w '${FMT}' 'https://127.0.0.1:${c.tap_port}/cgi-bin/speed?bytes=${small ? 1 : bytes}' > ${shq(out)} 2>/dev/null`;
	let m = match(c.test_url, /^(https?):\/\/(\[[0-9a-fA-F:.]+\]|[^:\/?#]+)(:([0-9]+))?/);
	let port = (m && m[4]) ? m[4] : ((m && m[1] == 'http') ? '80' : '443');
	let to = `--connect-to ${shq((m ? m[2] : '') + ':' + port + ':127.0.0.1:' + c.tap_port)}`;
	if (small)
		return `curl -sk -m ${timeout} -I ${to} -o /dev/null -w '${FMT}' ${shq(c.test_url)} > ${shq(out)} 2>/dev/null`;
	// a server may ignore Range: head ends the download after the given bytes (curl reports a write error)
	return `curl -sk -m ${timeout} ${to} -w '%{stderr}${FMT}' ${shq(c.test_url)} 2> ${shq(out)} | head -c ${bytes} > /dev/null`;
}

// runs the requests through the given links (small ones at once, downloads one after the other)
function run(clients, bytes, timeout, small) {
	let cmd = '';
	for (let c in clients) {
		let line = curl_cmd(c, bytes, timeout, small, `${RUN}/m-${c.tag}.out`);
		if (small) cmd += `${line} &\n`;
		else system(line);
	}
	if (small && length(cmd)) system(cmd + 'wait\n');
	let out = {};
	for (let c in clients) {
		let f = `${RUN}/m-${c.tag}.out`, p = split(trim(readfile(f) ?? ''), ' ');
		unlink(f);
		let r = { time: time(), http: int(p[0] ?? 0), bytes: int(p[1] ?? 0), total: +(p[2] ?? 0), latency: +(p[3] ?? 0),
		          speed: int(+(p[4] ?? 0)), error: join(' ', slice(p, 5)) };
		r.ok = small ? (r.http > 0) : ((r.http == 200 || r.http == 206) && r.bytes > 0);
		if (r.ok) r.error = '';
		else if (!length(r.error)) r.error = r.http ? `HTTP ${r.http}` : 'no answer';
		out[c.tag] = r;
	}
	return out;
}

// ---- main ----

let uci = cursor();
uci.load(CFG);
let main = uci.get_all(CFG, 'main') ?? {};
if (main.enabled != '1') exit(0);
let what = ARGV[0] ?? '';
let st = read_json(STATE, {});
let clients = (type(st.clients) == 'array') ? st.clients : [];
let auto = (main.mode != 'manual');

if (what == 'started') {
	system(`${SELECT} >/dev/null 2>&1`);
	if (!auto || length(clients) < 2) exit(0);
	mkdir(RUN, 0o755);
	writefile(PENDING, `${time()}\n`);
	what = 'pending';
}
if (what == 'health' && auto && length(clients) >= 2 && access(PENDING) == true) what = 'pending';
if (what == 'pending' && uplink() == null) exit(0);
if (what == '' && (!auto || length(clients) < 2 || metered_uplink(main))) exit(0);
if (what == 'health' && (!auto || length(clients) < 2)) exit(0);
if (!length(clients)) exit(0);
mkdir(RUN, 0o755);
let held = lock(LOCK);
if (!held) exit(0);
let inst = instance();
if (!inst) exit(0);

// "profile: transport" for the messages on the page and in the log
let names = {};
for (let c in clients) names[c.tag] = `${c.profile_name ?? c.profile}: ${c.title ?? c.protocol}`;
function name(tag) { return names[tag] ?? (tag || 'none'); }

let bytes = int(main.test_bytes ?? 2000000); if (bytes < 10000) bytes = 10000; if (bytes > 20000000) bytes = 20000000;
let timeout = int(main.test_timeout ?? 15); if (timeout < 5) timeout = 5;
let threshold = int(main.test_threshold ?? 20); if (threshold < 0) threshold = 0;
let active = active_link(inst, st);

function switch_to(tag, reason) {
	writefile(AUTO, sprintf('%J\n', { active: tag, time: time(), reason: reason }));
	return exec(`${SELECT} ${shq(tag)}`).code == 0;
}

if (what == 'health') {
	let cur = filter(clients, c => c.tag == active);
	if (!length(cur)) {
		// xray holds no link of the configuration in effect: apply the one sync chose
		system(`${SELECT} >/dev/null 2>&1`);
		exit(0);
	}
	let r = run(cur, 0, 10, true)[active];
	let health = { time: time(), tag: active, ok: r.ok, error: r.error, decision: '' };
	if (!r.ok) {
		let others = filter(clients, c => c.tag != active), res = run(others, 0, 10, true), best = null;
		for (let c in others)
			if (res[c.tag].ok && (best == null || res[c.tag].latency < res[best].latency)) best = c.tag;
		health.decision = best ? `${name(best)} answers first and becomes active` : 'no other link answers; nothing changed';
		if (best && !switch_to(best, `${name(active)} did not answer, ${name(best)} answers first`)) health.decision += ' (switching failed)';
		log(`health check of ${name(active)} failed (${r.error}): ${health.decision}`);
	}
	let m = read_json(OUT, {});
	m.health = health;
	writefile(OUT, sprintf('%J\n', m));
	exit(0);
}

let results = run(clients, bytes, timeout, false);
// the measurement after a start is done once a link answered
if (what == 'pending' && length(filter(clients, c => results[c.tag].ok))) unlink(PENDING);
let hist = read_json(HIST, {});
for (let tag, r in results) {
	let h = (type(hist[tag]) == 'array') ? hist[tag] : [];
	push(h, { time: r.time, speed: r.speed, latency: r.latency, ok: r.ok });
	if (length(h) > HISTORY) h = slice(h, length(h) - HISTORY);
	hist[tag] = h;
}
for (let tag in keys(hist)) if (!length(filter(clients, c => c.tag == tag))) delete hist[tag];
writefile(HIST, sprintf('%J\n', hist));

let decision = '', switched = '';
if (auto) {
	let best = null;
	for (let c in clients) {
		let r = results[c.tag];
		if (r.ok && (best == null || r.speed > results[best].speed)) best = c.tag;
	}
	let cur = results[active] ?? null;
	if (best == null) decision = 'no link answered; nothing changed';
	else if (!cur || !cur.ok) { decision = `${name(active)} failed, ${name(best)} is the fastest`; switched = best; }
	else if (best != active && results[best].speed > cur.speed * (100 + threshold) / 100) { decision = `${name(best)} is more than ${threshold}% faster than ${name(active)}`; switched = best; }
	else decision = (best == active) ? `${name(active)} stays, the fastest` : `${name(active)} stays, ${name(best)} is faster by less than ${threshold}%`;
	if (switched && switched != active) {
		if (!switch_to(switched, decision)) decision += ' (switching failed)';
	}
	else switched = '';
}
writefile(OUT, sprintf('%J\n', { time: time(), bytes: bytes, mode: main.mode ?? 'auto', active_before: active, active_after: switched || active,
                                 decision: decision, clients: results, health: read_json(OUT, {}).health ?? null }));
log(`${what == 'pending' ? 'after a start: ' : ''}measured ${length(clients)} links: ` + join(', ', map(clients, c => `${name(c.tag)} ${results[c.tag].ok ? int(results[c.tag].speed / 1024) + ' KB/s' : 'failed'}`)) + (decision ? `; ${decision}` : ''));
