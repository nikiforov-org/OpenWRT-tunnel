#!/bin/sh
# select [TAG]: makes TAG the active link of the running xray (balancer "active", through its API,
# without a restart). Without an argument: the choice sync made for the configuration in effect
# (the configured link by hand, the last automatic choice, or the first link). Only a link of the
# configuration in effect is selected: xray accepts an override to any tag, also a removed one.
# Waits up to 30 s for the API after a start. Prints nothing; logs a switch.
API=127.0.0.1:61085
STATE=/tmp/tunnel-client/state.json
TAG="$1"
[ -n "$TAG" ] || TAG="$(jsonfilter -i $STATE -e '@.active' 2>/dev/null)"
[ -n "$TAG" ] || exit 0
if [ -z "$(jsonfilter -i $STATE -e "@.clients[@.tag='$TAG'].tag" 2>/dev/null)" ]; then
	logger -t tunnel-client "not selected: $TAG is not a link of the configuration in effect"
	exit 1
fi
# the current choice: the override if one is set, else the balancer's own selection
current() {
	xray api bi --server=$API active 2>/dev/null | awk '
		/Selecting Override:/ { sec = "o"; next }
		/Selects:/            { sec = "s"; next }
		/^[ \t]*[0-9]+[ \t]+/ { if (sec == "o" && o == "") o = $2; if (sec == "s" && s == "") s = $2 }
		END { print (o != "") ? o : s }'
}
NOW=""
for i in $(seq 1 30); do
	NOW="$(current)"
	[ -n "$NOW" ] && break
	sleep 1
done
[ -n "$NOW" ] || exit 1
[ "$NOW" = "$TAG" ] && exit 0
if xray api bo --server=$API -b active "$TAG" >/dev/null 2>&1 && [ "$(current)" = "$TAG" ]; then
	logger -t tunnel-client "active link: $TAG"
else
	logger -t tunnel-client "could not make $TAG the active link"
	exit 1
fi
