#!/bin/sh /etc/rc.common
# Applies /etc/config/tunnel-client: sync generates the xray configuration that intercepts the LAN
# (TPROXY) and sends it to the active link or directly by the list (the links of the profiles are
# the clients), then xray-service runs xray with it and with the configuration of
# luci-app-tunnel-server while that one is started, as one process (the procd service
# "tunnel-xray"), and applies the active link through xray's API (select) after every start of
# xray. LuCI's apply triggers a reload: procd restarts xray only when a file changed; with the
# client off its file is removed.

START=97
USE_PROCD=1

start_service() {
	# the instance of earlier versions, before the process was shared
	ubus call service delete '{"name":"tunnel-client","instance":"xray"}' >/dev/null 2>&1
	/usr/libexec/tunnel-client/sync
	/usr/libexec/tunnel-client/xray-service start /etc/tunnel-client/config.json
}

stop_service() {
	/usr/libexec/tunnel-client/xray-service stop /etc/tunnel-client/config.json
}

service_triggers() {
	procd_add_reload_trigger "tunnel-client"
}
