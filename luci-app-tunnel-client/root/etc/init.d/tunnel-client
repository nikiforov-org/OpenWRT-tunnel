#!/bin/sh /etc/rc.common
# Runs the xray process that intercepts the LAN (TPROXY) and sends it to the active link or directly
# by the list, with the configuration that sync generates from /etc/config/tunnel-client (the links
# of the profiles are the clients). LuCI's apply triggers a reload: sync runs again, procd restarts
# xray only when the generated file changed; with the client off the file is removed and xray
# stops. The active link is then applied through xray's API (select), without a restart.

START=97
USE_PROCD=1

PROG=/usr/bin/xray
CONF=/etc/tunnel-client/config.json

start_service() {
	/usr/libexec/tunnel-client/sync
	[ -s "$CONF" ] && [ -x "$PROG" ] || return 0
	procd_open_instance xray
	procd_set_param command "$PROG" run -config "$CONF"
	procd_set_param env XRAY_LOCATION_ASSET=/etc/tunnel-client/sources
	procd_set_param file "$CONF"
	procd_set_param limits nofile="16384 16384"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
	( /usr/libexec/tunnel-client/select >/dev/null 2>&1 & )
}

service_triggers() {
	procd_add_reload_trigger "tunnel-client"
}
