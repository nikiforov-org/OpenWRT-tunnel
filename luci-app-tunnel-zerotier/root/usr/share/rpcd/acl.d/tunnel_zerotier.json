{
	"tunnel_zerotier": {
		"description": "Manage this router's ZeroTier node and the networks of the ZeroTier Central account",
		"read": {
			"ubus": {
				"tunnel_zerotier": [ "status", "central_networks", "members", "routes", "log" ]
			},
			"uci": [ "tunnel_zerotier" ]
		},
		"write": {
			"ubus": {
				"tunnel_zerotier": [ "set_member", "del_member", "set_routes", "create_network", "del_network", "authorize_self", "restart" ]
			},
			"uci": [ "tunnel_zerotier" ]
		}
	}
}
