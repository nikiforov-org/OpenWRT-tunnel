#!/usr/bin/env ucode
// tunnel-zerotier sync: make the system match /etc/config/tunnel-zerotier.
//   sync          apply (idempotent): the stock zerotier service's enabled flag and network
//                 sections, the firewall zone for the zt+ interfaces, this node's authorization
//                 in ZeroTier Central for every configured network
//   sync revert   undo everything the package configured (used when the package is removed)

'use strict';

import { access, popen, readfile, writefile, mkdir, unlink, chmod } from 'fs';
import { cursor } from 'uci';

const CFG  = 'tunnel-zerotier';
const RUN  = '/tmp/tunnel-zerotier';
const ERROR = `${RUN}/error`;
const CLI  = '/usr/bin/zerotier-cli';
const API  = 'https://api.zerotier.com/api/v1';
const ZONE = 'tunnel_zerotier';
const FWD  = { wan: 'tunnel_zerotier_wan', lan: 'tunnel_zerotier_lan', from_lan: 'tunnel_zerotier_from_lan' };
const STOCK_EXAMPLE = '8056c2e21c000001';     // the "earth" example section shipped by the zerotier package
const MANAGED = '/etc/tunnel-zerotier/managed';   // exists while this package runs the stock service

const mode = ARGV[0] ?? 'apply';

function shq(s) {
	return "'" + replace(`${s ?? ''}`, "'", "'\\''") + "'";
}

function exec(command) {
	let p = popen(command, 'r');
	if (p == null)
		return { code: -1, out: '' };
	let out = p.read('all') ?? '';
	return { code: p.close(), out: out };
}

function log(msg) {
	system(`logger -t ${CFG} ${shq(msg)}`);
}

function flag(v, dflt) {
	return (v == null || v == '') ? dflt : (v == '1');
}

function valid_nwid(s) {
	return type(s) == 'string' && match(s, /^[0-9a-f]{16}$/) != null;
}

function uset(uci, cfg, sec, opt, val) {
	let cur = uci.get(cfg, sec, opt);
	let same = (type(val) == 'array') ? (type(cur) == 'array' ? join(' ', cur) == join(' ', val) : (length(val) == 1 && cur == val[0])) : (cur == val);
	if (same) return false;
	uci.set(cfg, sec, opt, val);
	return true;
}

function set_error(msg) {
	mkdir(RUN, 0o755);
	writefile(ERROR, msg);
	log(`not applied: ${msg}`);
}

// ---- the stock zerotier service: enabled flag and one network section per configured network ----

function sync_zerotier(enabled, networks) {
	// switched off here and never switched on here: the stock service is left alone
	if (!enabled && access(MANAGED) != true)
		return true;
	let uci = cursor();
	if (!uci.load('zerotier')) {
		set_error('the zerotier package is not installed (/etc/config/zerotier is missing)');
		return false;
	}
	let changed = false;
	if (uci.get('zerotier', 'global') != 'zerotier') {
		uci.set('zerotier', 'global', 'zerotier');
		changed = true;
	}
	changed = uset(uci, 'zerotier', 'global', 'enabled', enabled ? '1' : '0') || changed;
	let want = {};
	for (let n in networks)
		want[`tunnel_zerotier_${n.sid}`] = n.id;
	let stale = [];
	uci.foreach('zerotier', 'network', function(s) {
		let name = s['.name'];
		if (name in want) return;
		if (index(name, 'tunnel_zerotier_') == 0 || s.id == STOCK_EXAMPLE)
			push(stale, name);                   // ours from an earlier apply, or the shipped example
	});
	for (let name in stale) {
		uci.delete('zerotier', name);
		changed = true;
	}
	for (let sec, id in want) {
		if (uci.get('zerotier', sec) != 'network') { uci.set('zerotier', sec, 'network'); changed = true; }
		changed = uset(uci, 'zerotier', sec, 'id', id) || changed;
		changed = uset(uci, 'zerotier', sec, 'allow_managed', '1') || changed;
		changed = uset(uci, 'zerotier', sec, 'allow_global', '0') || changed;
		changed = uset(uci, 'zerotier', sec, 'allow_default', '0') || changed;
		changed = uset(uci, 'zerotier', sec, 'allow_dns', '0') || changed;
	}
	if (changed) {
		uci.commit('zerotier');
		chmod('/etc/config/zerotier', 0o600);      // holds the node's identity secret
	}
	if (enabled) {
		mkdir('/etc/tunnel-zerotier', 0o755);
		writefile(MANAGED, '');
		system('/etc/init.d/zerotier enable >/dev/null 2>&1');
		if (changed || exec('pidof zerotier-one').code != 0) {
			system('/etc/init.d/zerotier restart >/dev/null 2>&1');
			log(`zerotier service restarted: networks ${length(networks) ? join(', ', map(networks, n => n.id)) : 'none'}`);
		}
	}
	else {
		system('/etc/init.d/zerotier stop >/dev/null 2>&1; /etc/init.d/zerotier disable >/dev/null 2>&1');
		unlink(MANAGED);
		log('zerotier service stopped');
	}
	return true;
}

// ---- firewall: a zone for the zt+ interfaces ----

function sync_firewall(enabled, local_access) {
	let uci = cursor();
	uci.load('firewall');
	let changed = false;
	if (enabled) {
		if (uci.get('firewall', ZONE) != 'zone') { uci.set('firewall', ZONE, 'zone'); changed = true; }
		changed = uset(uci, 'firewall', ZONE, 'name', ZONE) || changed;
		changed = uset(uci, 'firewall', ZONE, 'device', [ 'zt+' ]) || changed;
		changed = uset(uci, 'firewall', ZONE, 'input', local_access ? 'ACCEPT' : 'REJECT') || changed;
		changed = uset(uci, 'firewall', ZONE, 'output', 'ACCEPT') || changed;
		changed = uset(uci, 'firewall', ZONE, 'forward', 'REJECT') || changed;
		changed = uset(uci, 'firewall', ZONE, 'mtu_fix', '1') || changed;
		let want = { wan: true, lan: local_access, from_lan: local_access };
		for (let key, sec in FWD) {
			if (want[key]) {
				if (uci.get('firewall', sec) != 'forwarding') { uci.set('firewall', sec, 'forwarding'); changed = true; }
				changed = uset(uci, 'firewall', sec, 'src', key == 'from_lan' ? 'lan' : ZONE) || changed;
				changed = uset(uci, 'firewall', sec, 'dest', key == 'from_lan' ? ZONE : key) || changed;
			}
			else if (uci.get('firewall', sec) == 'forwarding') {
				uci.delete('firewall', sec);
				changed = true;
			}
		}
	}
	else {
		for (let key, sec in FWD)
			if (uci.get('firewall', sec) == 'forwarding') { uci.delete('firewall', sec); changed = true; }
		if (uci.get('firewall', ZONE) == 'zone') { uci.delete('firewall', ZONE); changed = true; }
	}
	if (!changed) return;
	uci.commit('firewall');
	system('/etc/init.d/firewall reload >/dev/null 2>&1');
	log(`firewall zone ${ZONE}: ${enabled ? (local_access ? 'router and LAN reachable, exit to WAN' : 'exit to WAN only') : 'removed'}`);
}

// ---- ZeroTier Central: authorize this router's node in every configured network ----

function node_id() {
	for (let i = 0; i < 10; i++) {
		let r = exec(`${CLI} -j info 2>/dev/null`);
		let j; try { j = json(r.out); } catch (e) { j = null; }
		if (j?.address) return j.address;
		system('sleep 1');
	}
	return '';
}

function authorize_self(token, networks) {
	if (!token || !length(networks) || access(CLI, 'x') != true) return;
	let id = node_id();
	if (!id) { log('node id not available yet, authorization in Central skipped'); return; }
	let host = trim(readfile('/proc/sys/kernel/hostname') ?? '') || 'router';
	for (let n in networks) {
		let payload = sprintf('%J', { name: host, config: { authorized: true } });
		let r = exec(`curl -s -m 15 -o /dev/null -w '%{http_code}' -X POST -H ${shq('Authorization: Bearer ' + token)} -H 'Content-Type: application/json' -d ${shq(payload)} ${shq(API + '/network/' + n.id + '/member/' + id)}`);
		let code = trim(r.out);
		log(`Central: node ${id} in ${n.id}: ${code == '200' ? 'authorized' : 'not authorized (HTTP ' + code + ')'}`);
	}
}

// ---- main ----

let uci = cursor();
uci.load(CFG);
let main = uci.get_all(CFG, 'main') ?? {};
let networks = [];
uci.foreach(CFG, 'network', function(s) {
	if (flag(s.enabled, true) && valid_nwid(s.id))
		push(networks, { sid: s['.name'], id: s.id });
});
chmod(`/etc/config/${CFG}`, 0o600);
unlink(ERROR);

let enabled = (mode == 'apply' && flag(main.enabled, false));
let local_access = flag(main.local_access, true);
if (enabled && access(CLI, 'x') != true) {
	set_error('the zerotier package is not installed (/usr/bin/zerotier-cli is missing)');
	enabled = false;
}
if (sync_zerotier(enabled, enabled ? networks : [])) {
	sync_firewall(enabled, local_access);
	if (enabled)
		authorize_self(main.api_token, networks);
}
