#!/bin/sh /etc/rc.common
# Applies /etc/config/tunnel-zerotier to the system: the network sections and the enabled flag
# of the stock zerotier service, the firewall zone for the ZeroTier interfaces and the
# authorization of this router's node in ZeroTier Central.

START=96
USE_PROCD=1

start_service() {
	/usr/libexec/tunnel-zerotier/sync
}

reload_service() {
	/usr/libexec/tunnel-zerotier/sync
}

service_triggers() {
	procd_add_reload_trigger "tunnel-zerotier"
}
