#!/bin/sh /etc/rc.common
# Runs Xray with the configuration that sync generates from /etc/config/tunnel_server-xray.
# LuCI's apply triggers a reload: sync runs again and procd restarts Xray only when the
# generated file changed; with the server switched off the file is removed and Xray stops.

START=99
USE_PROCD=1

PROG=/usr/bin/xray
CONF=/etc/tunnel_server-xray/config.json

start_service() {
	/usr/libexec/tunnel_server-xray/sync
	[ -s "$CONF" ] && [ -x "$PROG" ] || return 0
	procd_open_instance xray
	procd_set_param command "$PROG" run -config "$CONF"
	procd_set_param file "$CONF"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "tunnel_server-xray"
}
