#!/usr/bin/env ucode
// tunnel_server-tor sync: make the system match /etc/config/tunnel_server-tor.
//   sync          apply (idempotent): this package's tor configuration file (bridges, the onion
//                 service, the authorized clients), its inclusion through tor.conf.tail_include,
//                 the stock tor service
//   sync revert   undo everything the package configured (used when the package is removed)
// The configuration file is replaced only after "tor --verify-config" accepts the result; any
// error leaves the configuration in effect in place, with the reason in
// /tmp/tunnel_server-tor/error for the status page. Only switching the service off removes it.

'use strict';

import { access, popen, readfile, writefile, mkdir, unlink, chmod, rename, lsdir } from 'fs';
import { cursor } from 'uci';

const CFG     = 'tunnel_server-tor';
const DIR     = '/etc/tunnel_server-tor';
const CONF    = `${DIR}/torrc`;                   // appended to the stock torrc by the tor init script
const NEW     = `${DIR}/torrc.new`;
const HS      = '/etc/tor/tunnel_server-tor';       // the onion service directory (owned by the tor user)
const CLIENTS = `${HS}/authorized_clients`;
const RUN     = '/tmp/tunnel_server-tor';
const ERROR   = `${RUN}/error`;
const MANAGED = `${DIR}/managed`;                  // exists while this package runs the stock service
const TOR     = '/usr/sbin/tor';
const BRIDGES = '/usr/share/tunnel_server-tor/bridges.txt';

const mode = ARGV[0] ?? 'apply';

function shq(s) {
	return "'" + replace(`${s ?? ''}`, "'", "'\\''") + "'";
}

function exec(command) {
	let p = popen(command, 'r');
	if (p == null)
		return { code: -1, out: '' };
	let out = p.read('all') ?? '';
	return { code: p.close(), out: out };
}

function log(msg) {
	system(`logger -t ${CFG} ${shq(msg)}`);
}

function flag(v, dflt) {
	return (v == null || v == '') ? dflt : (v == '1');
}

function list(v) {
	if (type(v) == 'array') return v;
	return (v == null || v == '') ? [] : [ v ];
}

function set_error(msg) {
	mkdir(RUN, 0o755);
	writefile(ERROR, msg);
	log(`not applied: ${msg}`);
}

// ---- client keys: x25519, base32 as Tor expects them ----

function base32(bytes) {
	const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
	let out = '', bits = 0, val = 0;
	for (let i = 0; i < length(bytes); i++) {
		val = ((val << 8) | ord(bytes, i)) & 0x1fff;
		bits += 8;
		while (bits >= 5) { out += substr(A, (val >> (bits - 5)) & 31, 1); bits -= 5; }
	}
	if (bits > 0) out += substr(A, (val << (5 - bits)) & 31, 1);
	return out;
}

function base32_decode(s) {
	const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
	let out = '', bits = 0, val = 0;
	for (let i = 0; i < length(s); i++) {
		let v = index(A, uc(substr(s, i, 1)));
		if (v < 0) return null;
		val = ((val << 5) | v) & 0x1fff;
		bits += 5;
		if (bits >= 8) { out += chr((val >> (bits - 8)) & 255); bits -= 8; }
	}
	return out;
}

function valid_key(s) {
	return type(s) == 'string' && match(s, /^[A-Z2-7]{52}$/) != null;
}

// the public key of a base32 private key, through openssl (DER prefix of an x25519 private key)
function public_key(priv) {
	if (!valid_key(priv)) return '';
	let raw = base32_decode(priv);
	if (raw == null || length(raw) != 32) return '';
	mkdir(RUN, 0o700);
	let pem = `${RUN}/key.pem`;
	writefile(pem, "-----BEGIN PRIVATE KEY-----\n" + b64enc(hexdec('302e020100300506032b656e04220420') + raw) + "\n-----END PRIVATE KEY-----\n");
	chmod(pem, 0o600);
	let r = exec(`openssl pkey -in ${shq(pem)} -pubout -outform DER 2>/dev/null`);
	unlink(pem);
	if (r.code != 0 || length(r.out) < 32) return '';
	return base32(substr(r.out, length(r.out) - 32));
}

// ---- the configuration file ----

function valid_bridge(line) {
	return match(line, /^(obfs4|snowflake|meek_lite|webtunnel) [^ ]+:[0-9]+ [0-9A-Fa-f]{40}( [^ ]+)*$/) != null
	    || match(line, /^[^ ]+:[0-9]+ [0-9A-Fa-f]{40}$/) != null;
}

function build(main, ports) {
	let errors = [], lines = [ '# generated by tunnel_server-tor from /etc/config/tunnel_server-tor' ];
	let bridges = main.bridges ?? 'builtin';
	if (bridges == 'builtin') {
		let text = readfile(BRIDGES) ?? '';
		if (!length(text)) push(errors, `the built-in bridge list ${BRIDGES} is missing`);
		push(lines, 'UseBridges 1', 'ClientTransportPlugin snowflake exec /usr/bin/snowflake-client', 'ClientTransportPlugin obfs4 exec /usr/bin/obfs4proxy');
		for (let l in split(rtrim(text, '\n'), '\n'))
			if (index(l, 'Bridge ') == 0) push(lines, l);
	}
	else if (bridges == 'custom') {
		let own = list(main.bridge);
		if (!length(own)) push(errors, 'no bridge lines are set');
		push(lines, 'UseBridges 1', 'ClientTransportPlugin snowflake exec /usr/bin/snowflake-client', 'ClientTransportPlugin obfs4 exec /usr/bin/obfs4proxy');
		for (let l in own) {
			l = trim(replace(trim(l), /^Bridge +/, ''));
			if (!valid_bridge(l)) push(errors, `bridge line not understood: "${substr(l, 0, 40)}"`);
			push(lines, `Bridge ${l}`);
		}
	}
	if (!length(ports)) push(errors, 'no onion service port is set');
	if (length(errors)) return { errors: errors };
	push(lines, `HiddenServiceDir ${HS}`, 'HiddenServiceVersion 3');
	for (let p in ports)
		push(lines, `HiddenServicePort ${p} 127.0.0.1:${p}`);
	return { text: join('\n', lines) + '\n' };
}

function prepare_dirs() {
	mkdir(DIR, 0o755);
	mkdir(HS, 0o700);
	mkdir(CLIENTS, 0o700);
	system(`chown -R tor:tor ${shq(HS)} 2>/dev/null; chmod 700 ${shq(HS)} ${shq(CLIENTS)}`);
}

// the authorized_clients directory: one .auth file per enabled profile; returns true on a change
function sync_clients(profiles) {
	let want = {};
	for (let p in profiles) {
		let pub = public_key(p.private_key);
		if (!pub) continue;
		want[`${p.name}.auth`] = `descriptor:x25519:${pub}\n`;
	}
	let changed = false;
	for (let f in (lsdir(CLIENTS) ?? [])) {
		if (!(f in want)) { unlink(`${CLIENTS}/${f}`); changed = true; }
	}
	for (let f, content in want) {
		let path = `${CLIENTS}/${f}`;
		if (readfile(path) != content) { writefile(path, content); chmod(path, 0o600); changed = true; }
	}
	if (changed) system(`chown -R tor:tor ${shq(HS)} 2>/dev/null`);
	return changed;
}

// 'same' when CONF already holds this configuration, 'written' after a successful check, false otherwise
function write_config(text) {
	if (readfile(CONF) == text) {
		system(`chown root:tor ${shq(CONF)} 2>/dev/null; chmod 640 ${shq(CONF)}`);
		return 'same';
	}
	if (access(TOR, 'x') != true) {
		set_error('tor is not installed (/usr/sbin/tor is missing)');
		return false;
	}
	writefile(NEW, text);
	chmod(NEW, 0o600);
	// verify the stock torrc with this file appended, the way the tor init script builds it
	let test = `${RUN}/torrc.test`;
	mkdir(RUN, 0o700);
	writefile(test, (readfile('/etc/tor/torrc') ?? '') + '\n' + text);
	let r = exec(`${TOR} --verify-config -f ${shq(test)} 2>&1`);
	unlink(test);
	if (r.code != 0) {
		unlink(NEW);
		let bad = filter(split(rtrim(r.out, '\n'), '\n'), l => index(l, '[warn]') >= 0 || index(l, '[err]') >= 0);
		let last = bad[length(bad) - 1] ?? 'tor --verify-config failed';
		set_error('tor rejected the configuration: ' + trim(replace(last, /^.*\[(warn|err)\] /, '')));
		return false;
	}
	rename(NEW, CONF);
	system(`chown root:tor ${shq(CONF)} 2>/dev/null; chmod 640 ${shq(CONF)}`);
	log('configuration written');
	return 'written';
}

// ---- the stock tor service ----

// enabled: this package's file is included and tor runs; changed: tor has to restart to read it
function sync_tor(enabled, changed) {
	let uci = cursor();
	if (!uci.load('tor')) {
		if (enabled) set_error('the tor package is not installed (/etc/config/tor is missing)');
		return;
	}
	let incl = list(uci.get('tor', 'conf', 'tail_include'));
	let has = (index(incl, CONF) >= 0);
	let uci_changed = false;
	if (enabled && !has) { push(incl, CONF); uci_changed = true; }
	if (!enabled && has) { incl = filter(incl, x => x != CONF); uci_changed = true; }
	if (uci_changed) {
		if (uci.get('tor', 'conf') != 'tor') uci.set('tor', 'conf', 'tor');
		if (length(incl)) uci.set('tor', 'conf', 'tail_include', incl);
		else uci.delete('tor', 'conf', 'tail_include');
		uci.commit('tor');
	}
	let running = (exec('pidof tor >/dev/null 2>&1').code == 0);
	if (enabled) {
		if (access(MANAGED) != true && system('/etc/init.d/tor enabled >/dev/null 2>&1') != 0)
			writefile(MANAGED, '');                 // the service was off: this package switches it on
		system('/etc/init.d/tor enable >/dev/null 2>&1');
		if (uci_changed || changed || !running) {
			// always a restart: the stock reload (SIGHUP) makes tor re-read /etc/tor/torrc as the
			// tor user, which cannot read it, and tor exits
			system('/etc/init.d/tor restart >/dev/null 2>&1');
			log('tor service restarted');
		}
	}
	else if (has) {
		if (access(MANAGED) == true) {
			system('/etc/init.d/tor stop >/dev/null 2>&1; /etc/init.d/tor disable >/dev/null 2>&1');
			unlink(MANAGED);
			log('tor service stopped');
		}
		else if (running) {
			system('/etc/init.d/tor restart >/dev/null 2>&1');  // the service belongs to someone else: only this package's part goes
			log('tor service restarted without this package\'s configuration');
		}
	}
}

// ---- main ----

let uci = cursor();
uci.load(CFG);
let main = uci.get_all(CFG, 'main') ?? {};
let profiles = [];
let seen = {};
uci.foreach(CFG, 'profile', function(s) {
	let name = trim(s.name ?? '');
	if (!flag(s.enabled, true) || !match(name, /^[A-Za-z0-9._-]{1,64}$/) || (name in seen)) return;
	seen[name] = true;
	push(profiles, { name: name, private_key: trim(s.private_key ?? '') });
});
chmod(`/etc/config/${CFG}`, 0o600);
unlink(ERROR);

let enabled = (mode == 'apply' && flag(main.enabled, false));
if (enabled && access(TOR, 'x') != true) {
	set_error('the tor package is not installed (/usr/sbin/tor is missing)');
	enabled = false;
}
let changed = false;
if (enabled) {
	prepare_dirs();
	let ports = filter(map(list(main.port), p => int(p)), p => p >= 1 && p <= 65535);
	let b = build(main, ports);
	if (b.errors)
		set_error(join('; ', b.errors));
	else
		changed = (write_config(b.text) == 'written');
	if (sync_clients(profiles))
		changed = true;
	if (access(CONF) != true)
		enabled = false;                          // nothing in effect yet: the service stays off, the error says why
}
else {
	unlink(CONF);
	unlink(NEW);
}
sync_tor(enabled, changed);
