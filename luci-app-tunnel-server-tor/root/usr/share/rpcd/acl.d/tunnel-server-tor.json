{
	"tunnel-server-tor": {
		"description": "Manage the Tor onion service of the router and its authorized clients",
		"read": {
			"ubus": {
				"tunnel-server-tor": [ "status", "keypair", "pubkey", "links", "config", "log" ]
			},
			"uci": [ "tunnel-server-tor" ]
		},
		"write": {
			"ubus": {
				"tunnel-server-tor": [ "restart", "update_bridges" ]
			},
			"uci": [ "tunnel-server-tor" ]
		}
	}
}
