#!/bin/sh /etc/rc.common
# Applies /etc/config/tunnel-server-tor to the system: the stock tor service with this package's
# configuration file (bridges, the onion service, the authorized clients) appended through
# tor.conf.tail_include.

START=96
USE_PROCD=1

start_service() {
	/usr/libexec/tunnel-server-tor/sync
}

reload_service() {
	/usr/libexec/tunnel-server-tor/sync
}

service_triggers() {
	procd_add_reload_trigger "tunnel-server-tor"
}
